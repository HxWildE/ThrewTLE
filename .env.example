# ThrewTLE Environment Configuration Template
PROJECT_NAME="ThrewTLE"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Connection
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/threwtle
# Local Development SQLite async fallback: sqlite+aiosqlite:///./threwtle.db
DATABASE_URL="sqlite+aiosqlite:///./threwtle.db"

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Optional AI Integration (leave empty for deterministic-only operation)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Hugging Face Dataset & Sync Settings
HUGGINGFACE_DATASET_NAME="neulab/leetcode"
SYNC_BATCH_SIZE=50
LOG_LEVEL="INFO"
